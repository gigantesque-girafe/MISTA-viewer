# MISTA path configuration — copy to `.env` and edit for this machine.
# The scripts in scripts/ load this file; nothing here is committed with real paths.
#
# On Windows PowerShell you can also just set these per-session:
#   $env:MISTA_DATA_ROOT = "D:\dataMISTA"
# or in cmd.exe:
#   set MISTA_DATA_ROOT=D:\dataMISTA

# Repo root. Leave unset to auto-detect from the code location.
# MISTA_ROOT=

# Dataset root (ZJU-MoCap / AIST++ / Neuman / PeopleSnapshot live under here).
# Only needed for training / dataset-based rendering, not the live webcam demo.
MISTA_DATA_ROOT=D:/dataMISTA

# SMPL body-model dir. Defaults to <MISTA_ROOT>/body_models if unset.
# MISTA_BODY_MODELS=

# Trained MISTA avatar checkpoint (.pth) used by the launcher and README examples.
MISTA_CKPT=D:/dataMISTA/MISTA/TrainScratch_TT5D_8p_ratio_05/ckpt50000.pth

# --- optional (training only) ---
# MISTA_SIF=D:/mista.sif          # Singularity image for train5d.sh
# WANDB_API_KEY=
# WANDB_PROJECT=mista
